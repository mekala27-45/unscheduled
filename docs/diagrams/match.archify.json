 "cards": [
  {
   "dot": "rose",
   "title": "What never leaves or stays",
   "items": [
    "Only package names and ecosystems go to the OSV API; the document stays in memory",
    "The match log keeps the digest and the counts, never the SBOM, and the client only as a salted hash"
   ]
  },
  {
   "dot": "amber",
   "title": "When it refuses",
   "items": [
    "413 past the upload limit, 415 for another media type, 422 for a document that is neither CycloneDX nor SPDX, 429 when the budget for the day is spent",
    "503 when the OSV API cannot be read; the match is logged with that status"
   ]
  }
 ]
