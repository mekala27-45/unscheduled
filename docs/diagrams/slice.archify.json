 "cards": [
  {
   "dot": "cyan",
   "title": "Keys the code keeps",
   "items": [
    "The sync copies cve, cve_event, product and finding from the serving bundle: a sweep deletes the rows the new file no longer holds, then each chunk is upserted by key, and a row whose digest is unchanged is not written",
    "cve_event.cve_id and finding.product_id name their rows by value; no foreign key is declared, and the sync loads each table on its own, in the order cve, cve_event, product, finding"
   ]
  },
  {
   "dot": "rose",
   "title": "What is never stored",
   "items": [
    "An uploaded SBOM: match_log keeps its sha256 and counts",
    "A client address in clear: client_budget and match_log keep a salted hash"
   ]
  }
 ]
}