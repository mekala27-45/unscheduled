  "cards": [
    {
      "dot": "cyan",
      "title": "The dated fact",
      "items": [
        "Every value published about a CVE is kept with when it became known and when it stopped",
        "The as-of engine answers what was known at any time, tested with a planted future fact"
      ]
    },
    {
      "dot": "rose",
      "title": "No secret in Actions",
      "items": [
        "The API pulls the serving release and checks every digest before it loads a chunk",
        "Vercel holds the database connection through the Neon integration; nobody typed it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two engines, one answer",
      "items": [
        "osv-scanner checks every finding the matcher makes, and a disagreement needs a reason",
        "The CLI calls the same services as the API, so both give the same answers"
      ]
    }
  ]
