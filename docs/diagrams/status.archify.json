 "cards": [
  {
   "dot": "cyan",
   "title": "Dated by the change history",
   "items": [
    "Received, Analyzed, Modified and Rejected each follow an event in the NVD change history, and the lake dates them by that event",
    "The status a record holds today is dated by the record's last modification",
    "Reanalysis and Modified Analysis events return a Modified CVE to Analyzed, as Initial Analysis does the first time"
   ]
  },
  {
   "dot": "amber",
   "title": "Dated by the first fetch",
   "items": [
    "Awaiting Analysis, Undergoing Analysis and Deferred have no event in the history; the lake sees them only in the current record and dates them by the first fetch that saw them",
    "A dashed arrow is a move with no event in the history, so in the lake a CVE goes from Received straight to Analyzed",
    "Since 15 April 2026 the NVD gives Deferred to the CVEs outside the KEV catalog, federal software and critical software"
   ]
  },
  {
   "dot": "rose",
   "title": "Before the history",
   "items": [
    "A CVE published before the change history began starts at Analyzed or Received, dated from its publication and flagged before_history",
    "Rejected can follow any status; an unrejected CVE returns to Received, or to Modified when it was analyzed before"
   ]
  }
 ]
