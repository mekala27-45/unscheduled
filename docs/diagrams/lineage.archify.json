 "cards": [
  {
   "dot": "cyan",
   "title": "One path for every number",
   "items": [
    "A number on a page is rendered from the manifest, the manifest from the parts the steps wrote, and each part from the lake or the exposure run",
    "The serving bundle is built from the same lake file, so the API and the report read one cut"
   ]
  },
  {
   "dot": "amber",
   "title": "What the exposure run also reads",
   "items": [
    "OSV all.zip and the GitHub advisory tree, locked by digest, for the ranges as each advisory version was known",
    "Bronze KEV, exploit signals and the NVD history, to count each finding as of its time"
   ]
  }
 ]
