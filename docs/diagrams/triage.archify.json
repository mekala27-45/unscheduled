 "cards": [
  {
   "dot": "rose",
   "title": "Nothing acts",
   "items": [
    "A decision resumes a run only when it names the hash of the draft it was shown",
    "No node applies a plan or files a warning; an approved draft is a record a person acts on"
   ]
  },
  {
   "dot": "violet",
   "title": "Checkpoints in Postgres",
   "items": [
    "Every step is a checkpoint; a run waits at an interrupt with its checkpoints in Neon",
    "A decided run keeps its latest checkpoint, and a run replays or forks from any of them"
   ]
  },
  {
   "dot": "cyan",
   "title": "As known then",
   "items": [
    "Every source answers as of the run time, never later",
    "Advisory text is fenced as untrusted, with its id and the time it became known"
   ]
  },
  {
   "dot": "amber",
   "title": "The floor",
   "items": [
    "Past a budget, the deadline, a refusal or two schema failures, the floor drafts from templates",
    "A model draft the verifier blocks is replaced by the floor's"
   ]
  }
 ]
