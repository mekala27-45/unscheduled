  "cards": [
    {
      "dot": "rose",
      "title": "No database secret in Actions",
      "items": [
        "Nothing pushes data in: the API pulls the newest serving release",
        "The trigger takes no input, so a stranger can only make it check sooner, inside the rate limit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Safe to call again",
      "items": [
        "Each call is one transaction; a failed call rolls back whole and a retry repeats the step",
        "A chunk is upserted by key with a row digest, so a rerun writes nothing"
      ]
    }
  ]
