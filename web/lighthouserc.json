{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3210/", "http://127.0.0.1:3210/app/cves/CVE-2099-0001"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:3210/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "/app/cves/",
          "assertions": { "categories:accessibility": ["error", { "minScore": 0.95 }] }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse" }
  }
}
